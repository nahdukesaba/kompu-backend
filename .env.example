# ---------- App ----------
APP_NAME=kompu-backend
APP_ENV=development            # development | production
PORT=8080
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

# ---------- Database (Supabase PostgreSQL) ----------
# Supabase Dashboard -> Project Settings -> Database -> Connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# ---------- Central SSO (sso-balai) ----------
# Base URL of sso-balai as reachable from THIS server (server-to-server call).
# Local: sso-balai runs on 127.0.0.1:18082. Production must be https.
SSO_BASE_URL=http://127.0.0.1:18082
SSO_VERIFY_TIMEOUT=5s

# ---------- Storage (Supabase Storage via S3 protocol) ----------
STORAGE_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
STORAGE_REGION=YOUR_PROJECT_REGION
STORAGE_BUCKET_JOBS=kompu-jobs
STORAGE_BUCKET_RELEASES=kompu-releases
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PRESIGN_EXPIRY=15m
# Limits in bytes: Jobs = 10 MB, Releases = 50 MB
MAX_JOB_FILE_BYTES=10485760
MAX_RELEASE_FILE_BYTES=52428800
# Lifetime of presigned download (display) URLs
STORAGE_DOWNLOAD_EXPIRY=1h

# ---------- AI Caption (POST /releases/generate-caption) ----------
# Any OpenAI-compatible chat-completions endpoint. Here: a local 9Router.
# Leave AI_BASE_URL empty to switch the feature off (the endpoint returns 503).
AI_BASE_URL=http://localhost:20128/v1
# The key shown in the 9Router dashboard (leave empty if your router needs none).
AI_API_KEY=
# The exact name of your free combo in 9Router (or a provider/model id).
AI_MODEL=
AI_TIMEOUT=45s

# Caption style guideline, read on every caption request. Delete the file to use the built-in style.
CAPTION_SKILLS_FILE=skills.md

