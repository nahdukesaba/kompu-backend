# ---------- App ----------
APP_NAME=kompu-backend
APP_ENV=development            # development | production
PORT=8080
# Comma-separated list of allowed frontend origins
# Local dev: kompu-web on http://kompu.test:8084 proxies /api to this backend (one origin).
CORS_ALLOWED_ORIGINS=http://kompu.test:8084
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

# ---------- Database (Supabase PostgreSQL) ----------
# Supabase Dashboard -> Project Settings -> Database -> Connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# ---------- Central SSO (sso-balai), browser SSO ----------
# Authorization code + PKCE S256; see docs/sso.md. The same Supabase DB as
# sso-balai is required (membership is read from public.app_memberships).
# Base URL of sso-balai: the browser is redirected to {SSO_BASE_URL}/authorize,
# so it must be reachable from browsers too. Production must be https.
SSO_BASE_URL=http://sso-balai.test:18082
SSO_VERIFY_TIMEOUT=10s
SSO_CLIENT_ID=kompu-web
# Must match sso-balai's SSO_KOMPU_REDIRECT_URIS / _POST_LOGOUT_REDIRECT_URIS byte for byte.
SSO_REDIRECT_URI=http://kompu.test:8084/auth/sso/callback
SSO_POST_LOGOUT_REDIRECT_URI=http://kompu.test:8084/login
# openssl rand -base64 32
SSO_FLOW_HMAC_KEY=
SSO_FLOW_TTL=5m
# openssl rand -base64 48 ; must equal sso-balai's SSO_KOMPU_INTROSPECTION_SECRET
SSO_INTROSPECTION_SECRET=

# ---------- App session cookie ----------
# openssl rand -base64 32 (exactly 32 bytes). Empty in development = random per restart.
APP_SESSION_KEY=
APP_SESSION_TTL=8h
# false only for local plain-http development
APP_SESSION_COOKIE_SECURE=false

# ---------- Storage (Supabase Storage via S3 protocol) ----------
STORAGE_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
STORAGE_REGION=YOUR_PROJECT_REGION
STORAGE_BUCKET_JOBS=kompu-jobs
STORAGE_BUCKET_RELEASES=kompu-releases
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PRESIGN_EXPIRY=15m
# Limits in bytes: Jobs = 10 MB, Releases = 50 MB
MAX_JOB_FILE_BYTES=10485760
MAX_RELEASE_FILE_BYTES=52428800
# Lifetime of presigned download (display) URLs
STORAGE_DOWNLOAD_EXPIRY=1h

# ---------- OneDrive file storage (Microsoft Graph) ----------
# When MS_TENANT_ID, MS_CLIENT_ID and MS_CLIENT_SECRET are set, uploads go to
# the OneDrive of the MS_REFRESH_TOKEN user under ONEDRIVE_ROOT instead of S3
# (S3 above stays as the source for `go run ./cmd/copy-files -apply`).
# Delegated scope: "offline_access Files.ReadWrite". The rotated refresh token
# is kept in public.graph_tokens (id 'kompu-onedrive'). Never commit real values.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REFRESH_TOKEN=
ONEDRIVE_ROOT=/db/kompu

# ---------- AI Caption (POST /releases/generate-caption) ----------
# Any OpenAI-compatible chat-completions endpoint. Here: a local 9Router.
# Leave AI_BASE_URL empty to switch the feature off (the endpoint returns 503).
AI_BASE_URL=http://localhost:20128/v1
# The key shown in the 9Router dashboard (leave empty if your router needs none).
AI_API_KEY=
# The exact name of your free combo in 9Router (or a provider/model id).
AI_MODEL=
AI_TIMEOUT=45s

# Caption style guideline, read on every caption request. Delete the file to use the built-in style.
CAPTION_SKILLS_FILE=skills.md

